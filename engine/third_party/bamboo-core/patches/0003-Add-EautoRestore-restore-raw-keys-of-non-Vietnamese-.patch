From 1e2234f0bfa89763421d985383498add42244b48 Mon Sep 17 00:00:00 2001
From: fix <fix@local>
Date: Fri, 30 Oct 2026 23:55:23 +0700
Subject: [PATCH 3/3] Add EautoRestore: restore raw keys of non-Vietnamese
 words at a word break
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

windows, Linux, text, cursor, text#primary (ibus-bamboo#429, fcitx5-bamboo#19) no
longer end as windớ/Linũ/tẽt. Opt-in flag so existing frontends are unchanged.
---
 bamboo.go               | 12 ++++++++++++
 regress_restore_test.go | 37 +++++++++++++++++++++++++++++++++++++
 2 files changed, 49 insertions(+)
 create mode 100644 regress_restore_test.go

diff --git a/bamboo.go b/bamboo.go
index d98c0c0..d0d299c 100644
--- a/bamboo.go
+++ b/bamboo.go
@@ -30,6 +30,9 @@ const (
 	EfreeToneMarking uint = 1 << iota
 	EstdToneStyle
 	EautoCorrectEnabled
+	// EautoRestore restores the raw keys of a non-Vietnamese word (windows, text, Linux)
+	// when a word-break key (space, punctuation, digit) is typed after it.
+	EautoRestore
 	EstdFlags = EfreeToneMarking | EstdToneStyle | EautoCorrectEnabled
 )
 
@@ -184,6 +187,9 @@ func (e *BambooEngine) ProcessKey(key rune, mode Mode) {
 	var lowerKey = unicode.ToLower(key)
 	var isUpperCase = unicode.IsUpper(key)
 	if mode&EnglishMode != 0 || !e.CanProcessKey(lowerKey) {
+		if mode&EnglishMode == 0 && IsWordBreakSymbol(lowerKey) {
+			e.restoreIfInvalid()
+		}
 		if mode&InReverseOrder != 0 {
 			e.composition = append([]*Transformation{newAppendingTrans(lowerKey, isUpperCase)}, e.composition...)
 			return
@@ -199,6 +205,12 @@ func (e *BambooEngine) ProcessKey(key rune, mode Mode) {
 	e.composition = e.newComposition(e.composition, lowerKey, isUpperCase)
 }
 
+func (e *BambooEngine) restoreIfInvalid() {
+	if e.flags&EautoRestore != 0 && !e.IsValid(true) {
+		e.RestoreLastWord(false)
+	}
+}
+
 func (e *BambooEngine) RestoreLastWord(toVietnamese bool) {
 	var previous, lastComb = extractLastWord(e.composition, e.GetInputMethod().Keys)
 	if len(lastComb) == 0 {
diff --git a/regress_restore_test.go b/regress_restore_test.go
new file mode 100644
index 0000000..368fc5d
--- /dev/null
+++ b/regress_restore_test.go
@@ -0,0 +1,37 @@
+package bamboo
+
+import "testing"
+
+// new tone style + auto-restore of non-Vietnamese words at a word break
+const fRst = EfreeToneMarking | EautoCorrectEnabled | EautoRestore
+
+func TestRegressAutoRestore(t *testing.T) { // upstream: ibus-bamboo#429, fcitx5-bamboo#19
+	run(t, []rc{
+		{"windows", T, fRst, "windows ", "windows "}, {"Linux", T, fRst, "Linux ", "Linux "},
+		{"text", T, fRst, "text ", "text "}, {"text.c", T, fRst, "text.c", "text.c"},
+		{"text#primary", T, fRst, "text#primary ", "text#primary "},
+		{"cursor", T, fRst, "cursor ", "cursor "}, {"Cursor", T, fRst, "Cursor ", "Cursor "},
+		{"ROMA", T, fRst, "ROMA ", "ROMA "}, {"roma", T, fRst, "roma ", "roma "},
+		{"windows-nospace", T, fNew, "windows", "windớ"}, // flag off: unchanged until commit
+		{"keep-valid", T, fRst, "vieetj ", "việt "}, {"keep-valid2", T, fRst, "Nguwowif ", "Người "},
+		{"keep-hoa", T, fRst, "hoaf,", "hoà,"}, {"uynh", T, fRst, "quynhs ", "quýnh "}, {"oe", T, fRst, "khoer ", "khoẻ "},
+		{"two-words", T, fRst, "windows vieetj ", "windows việt "},
+		{"digit", T, fRst, "text1", "text1"}, {"vni-digit-in-word", T, fRst, "viet65", "viet65"},
+		{"apostrophe", T, fRst, "don't ", "don't "}, {"its", T, fRst, "it's ", "it's "},
+		{"viqr-apostrophe", "Telex + VNI + VIQR", fRst, "rock'n'roll ", "rock'n'roll "},
+		{"ok-then-punct", T, fRst, "xin chaof!", "xin chào!"},
+		{"quote", T, fRst, "\"windows\"", "\"windows\""},
+		{"mixed-case-restore", T, fRst, "WINDOWS ", "WINDOWS "}, {"Windows", T, fRst, "Windows ", "Windows "},
+	})
+}
+
+func TestRegressNumbersPunct(t *testing.T) {
+	run(t, []rc{
+		{"num-after", T, fRst, "vieetj1", "việt1"}, {"num-word-num", T, fRst, "a1b", "a1b"},
+		{"comma", T, fRst, "chaof,", "chào,"}, {"dash", T, fRst, "tieengs-vieetj", "tiếng-việt"},
+		{"num-resets-tone-target", T, fNew, "hoa1f", "hoa1f"[:0] + "hoa1f"},
+		{"digits-vni", V, fNew, "viet65", "việt"},
+		{"punct-between", T, fNew, "toans.s", "toán.s"},
+		{"paren", T, fNew, "(vieetj)", "(việt)"},
+	})
+}
